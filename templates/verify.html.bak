<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Doğrulama Kodu — Telegram Forwarder</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<div class="page">

  <aside class="sidebar">
    <div class="sidebar-logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
      Forwarder
    </div>
    <span class="nav-section">Menü</span>
    <a class="nav-item" href="/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>Panel</a>
    <a class="nav-item active" href="/accounts/ekle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Hesap Ekle</a>
    <div class="sidebar-footer"><div class="status-pill"><div class="pulse"></div>Sistem Aktif</div></div>
  </aside>

  <main class="main">
    <div class="main-header">
      <h1>📲 SMS Kodu Doğrula</h1>
      <p>{{ phone }} numarasına SMS gönderdik</p>
    </div>

    <div class="card" style="max-width:480px">

      <div class="alert alert-info" style="margin-bottom:1.5rem">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>Telegramdan gelen <b>5 haneli kodu</b> gir. Birkaç saniye içinde gelir.</span>
      </div>

      <form action="/accounts/verify" method="POST">
        <input type="hidden" name="phone" value="{{ phone }}">

        <div class="field">
          <label>Doğrulama Kodu</label>
          <input type="text" name="code" id="code" placeholder="12345"
                 inputmode="numeric" maxlength="6" autofocus
                 style="font-size:1.5rem;text-align:center;letter-spacing:.5rem;font-weight:700">
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block mt-2">
          ✅ Doğrula ve Giriş Yap
        </button>
      </form>

      <div style="text-align:center;margin-top:1rem">
        <a href="/accounts/ekle" style="color:var(--muted2);font-size:.85rem;text-decoration:none">
          ← Geri dön
        </a>
      </div>
    </div>
  </main>
</div>
</body>
</html>
